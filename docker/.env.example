# Copy this file to .env (git-ignored) and fill in real values before running
# `docker compose up`. Never commit the real .env file.

# Postgres credentials — used to bootstrap the postgres container's superuser/database, and
# must match the password embedded in ConnectionStrings__Postgres below.
POSTGRES_USER=cinescout
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cinescout

# The app's connection string — same host/port/db/user as above, host is the "postgres"
# service name (Compose's internal DNS), not localhost.
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=cinescout;Username=cinescout;Password=change-me

# Upgrade-only, deprecated: only read once, at startup, while the seeded User row's password
# hash is still unset. If you're upgrading a deployment that already has this set, leave it
# as-is — it's copied into the database automatically on next boot, logged once, and never
# read again after that. New deployments should leave this empty.
Auth__PasswordHash=

# Sliding session lifetime in days. Optional — defaults to 30 if unset.
#Auth__SessionLifetimeDays=30

# Not yet consumed by the app (reserved for the Discord notifier ticket, #19) — documented here
# now per the deployment spec so the .env file doesn't need a breaking shape change later.
Discord__WebhookUrl=
