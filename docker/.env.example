# Copy this file to .env (git-ignored) and fill in real values before running
# `docker compose up`. Never commit the real .env file.

# Postgres credentials — used to bootstrap the postgres container's superuser/database, and
# must match the password embedded in ConnectionStrings__Postgres below.
POSTGRES_USER=cinescout
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cinescout

# The app's connection string — same host/port/db/user as above, host is the "postgres"
# service name (Compose's internal DNS), not localhost.
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=cinescout;Username=cinescout;Password=change-me

# Sliding session lifetime in days. Optional — defaults to 30 if unset.
#Auth__SessionLifetimeDays=30

# Discord webhook URL for the outgoing notifier. Optional — an unconfigured value is a clean
# "not configured" no-op, not a crash.
Discord__WebhookUrl=

# Hall-of-Fame recurring crawl interval, in hours. Optional — defaults to 1. Binds to cron's
# *hour* field (`0 */N * * *`), so it can't go below "top of the next hour" for any positive value.
#HallOfFame__CrawlIntervalHours=1

# Kinoheld recurring seat-crawl interval, in minutes (watched films' upcoming performances only).
# Also the on-demand performance-detail page's cache window: a snapshot younger than this is served
# from cache instead of fetched fresh.
# Optional — defaults to 30. Binds to cron's *minute* field, so unlike the Hall-of-Fame interval
# above it can be set as low as 1 for fast iteration.
#Kinoheld__SeatCrawlIntervalMinutes=30

# CIDR subnet of the "npm-network" the app joins (see docker-compose.yml) — the app trusts
# X-Forwarded-For/X-Forwarded-Proto headers only from this subnet, since TLS terminates at your
# externally-managed Nginx Proxy Manager, not here. Find the real subnet with
# `docker network inspect npm-network` (or whatever you named it) once it exists — the default
# Docker bridge subnet is often something like 172.x.0.0/16, but yours will differ. Left
# unconfigured, forwarded headers from anywhere are simply not trusted (safe default, but requests
# will show NPM's IP/scheme instead of the real client's).
ForwardedHeaders__KnownNetwork=
