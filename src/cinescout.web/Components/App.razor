@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    @* Embedded here, not fetched from a bootstrap endpoint — ADR 0004: App.razor's static-SSR pass
       already runs on every request (even for InteractiveWebAssembly pages, before the runtime
       boots), so IAntiforgery.GetAndStoreTokens(HttpContext) has a real HttpContext to work with
       for free. cinescout.web.Client reads this via JS interop at WASM startup (Program.cs) and
       attaches it as the X-CSRF-TOKEN header (matching AddAntiforgery's HeaderName) on mutating
       /api requests. *@
    <meta name="antiforgery-token" content="@_antiforgeryToken" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap-icons/bootstrap-icons.css"]" />
    <link rel="stylesheet" href="@Assets["lib/fonts/fonts.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["cinescout.css"]" />
    <link rel="stylesheet" href="@Assets["cinescout.web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="@Assets["lib/bootstrap/dist/js/bootstrap.bundle.min.js"]"></script>
    <script src="@Assets["js/password-toggle.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? _antiforgeryToken;

    protected override void OnInitialized()
    {
        if (HttpContext is not null)
        {
            _antiforgeryToken = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken;
        }
    }
}
