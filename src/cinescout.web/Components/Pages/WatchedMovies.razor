@page "/watched-movies"
@using cinescout.core.WatchedMovies
@using cinescout.persistence
@using Microsoft.EntityFrameworkCore
@inject CineScoutDbContext Db
@inject WatchedMovieService WatchedMovieService

<PageTitle>Watched Movies</PageTitle>

<h1>Watched Movies</h1>

<EditForm Model="this" FormName="watched-movies" OnSubmit="HandleSubmitAsync">
    <table class="table">
        <thead>
            <tr>
                <th>Film</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _rows)
            {
                <tr>
                    <td>@row.Title</td>
                    <td>
                        @if (row.IsWatched)
                        {
                            <button type="submit" class="btn btn-outline-secondary btn-sm" name="unwatchFilmId" value="@row.FilmId">Unwatch</button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-primary btn-sm" name="watchFilmId" value="@row.FilmId">Watch</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</EditForm>

@code {
    private List<FilmRow> _rows = [];

    [SupplyParameterFromForm]
    private int? WatchFilmId { get; set; }

    [SupplyParameterFromForm]
    private int? UnwatchFilmId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadRowsAsync();
    }

    private async Task LoadRowsAsync()
    {
        var watchedFilmIds = (await Db.WatchedMovies.Select(w => w.FilmId).ToListAsync()).ToHashSet();
        var films = await Db.Films.OrderBy(f => f.Title).ToListAsync();

        _rows = films
            .Select(f => new FilmRow(f.Id, f.Title, watchedFilmIds.Contains(f.Id)))
            .ToList();
    }

    private async Task HandleSubmitAsync()
    {
        if (WatchFilmId is int watchFilmId)
        {
            await WatchedMovieService.WatchAsync(watchFilmId, CancellationToken.None);
        }
        else if (UnwatchFilmId is int unwatchFilmId)
        {
            await WatchedMovieService.UnwatchAsync(unwatchFilmId, CancellationToken.None);
        }

        await LoadRowsAsync();
    }

    private sealed record FilmRow(int FilmId, string Title, bool IsWatched);
}
