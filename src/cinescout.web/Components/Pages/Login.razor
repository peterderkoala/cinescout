@page "/login"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@using cinescout.persistence
@using Microsoft.EntityFrameworkCore
@layout AuthLayout
@inject CineScoutDbContext Db
@inject NavigationManager NavigationManager

<PageTitle>Log in</PageTitle>

<h5 class="card-title mb-3">Log in</h5>

@if (!string.IsNullOrEmpty(Error))
{
    <div class="alert alert-danger py-2 small" role="alert">Invalid password.</div>
}

<form method="post" action="/account/login">
    <input type="hidden" name="returnUrl" value="@ReturnUrl" />
    <div class="mb-3 form-floating position-relative">
        <input type="password" name="password" id="password" class="form-control" autocomplete="current-password" required autofocus />
        <label for="password" class="form-label">Password</label>
        <button type="button" class="btn btn-sm position-absolute top-50 end-0 translate-middle-y me-2 border-0 text-secondary password-toggle" data-target="password" aria-label="Show password">
            <i class="bi bi-eye" aria-hidden="true"></i>
        </button>
    </div>
    <button type="submit" class="btn w-100 cs-btn-primary">Log in</button>
    <p class="text-center small mt-3 mb-0"><a href="/setup">First run? Set up CineScout</a></p>
</form>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var user = await Db.Users.FirstOrDefaultAsync();
        if (user?.PasswordHash is null)
        {
            NavigationManager.NavigateTo("/setup");
        }
    }
}
