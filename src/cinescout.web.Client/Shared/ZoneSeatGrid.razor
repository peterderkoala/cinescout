@*
    SeatGrid zone mode — Technical Design Spec.md §4.2 / SeatGrid.dc.html. Renders one
    FavoriteSeatMatrix's row/seat-number range as gold blocks, 16px cells / 2px gaps, capped at
    5x25 (SeatGridCapping) with a 35%-opacity ghost row/column plus a "+N rows · +N seats" caption
    for anything beyond the cap (issue #77: keeps every card the same height regardless of
    auditorium size).
*@
@using System.Globalization
@using cinescout.contracts

<div class="d-flex flex-column" style="gap:2px; width:max-content;">
    @for (var r = 0; r < Capping.RowsShown; r++)
    {
        <div class="d-flex" style="gap:2px;">@RowCells(1)</div>
    }
    @if (Capping.HasGhostRow)
    {
        <div class="d-flex" style="gap:2px;">@RowCells(0.35)</div>
    }
    @if (Capping.OverflowCaption.Length > 0)
    {
        <div class="fw-semibold" style="font-size:.72rem; letter-spacing:.04em; color:var(--cinescout-accent-match); margin-top:6px;">
            @Capping.OverflowCaption
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required ZoneSeatGridModel Matrix { get; set; }

    // RowStart/RowEnd are single Kinoheld row letters by domain convention (cinescout.model's own
    // doc comment), but nothing at the type level enforces that — guard against an empty string
    // reaching this component (e.g. from an editor that doesn't validate length) rather than
    // throwing IndexOutOfRangeException on a malformed matrix.
    private int RowCount => Matrix.RowStart.Length > 0 && Matrix.RowEnd.Length > 0
        ? Matrix.RowEnd[0] - Matrix.RowStart[0] + 1
        : 0;
    private int SeatCount => Matrix.SeatNumberEnd - Matrix.SeatNumberStart + 1;
    private SeatGridCappingResult Capping => SeatGridCapping.Compute(RowCount, SeatCount);

    private RenderFragment<double> RowCells => opacity =>
        @<text>
            @for (var c = 0; c < Capping.SeatsShown; c++)
            {
                <div style="width:16px; height:16px; flex:none; border-radius:2px; background:var(--cinescout-accent-match); opacity:@Opacity(opacity);"></div>
            }
            @if (Capping.HasGhostColumn)
            {
                <div style="width:16px; height:16px; flex:none; border-radius:2px; background:var(--cinescout-accent-match); opacity:@Opacity(opacity * 0.35);"></div>
            }
        </text>;

    private static string Opacity(double value) => value.ToString("0.####", CultureInfo.InvariantCulture);
}
