@page "/"
@using cinescout.contracts
@using cinescout.web.Client.Api
@using cinescout.web.Client.Shared
@inject HomeApiClient Api

@*
    Home screen — Technical Design Spec.md §5.6 / CineScout Prototype.dc.html
    (data-screen-label="Home"). Featured Active-Match cards (two-column), then a Tracked Movies
    panel (max 5) and Recent Activity (max 5). A build, not a retrofit (#97): this page needs DB
    access via the new HomeApiClient, so unlike the old 7-line WASM stub it fetches only once
    interactive (RendererInfo.IsInteractive, issue #86) — the static-prerender pass renders
    CardSkeleton instead.
*@

<PageTitle>Home</PageTitle>

@if (!RendererInfo.IsInteractive || _page is null)
{
    <h3 class="mb-3" style="color: var(--bs-body-color);">Active Matches</h3>
    <CardSkeleton Count="2" />
}
else
{
    <h3 class="mb-3" style="color: var(--bs-body-color);">Active Matches</h3>

    @if (_page.ActiveMatches.Count > 0)
    {
        <div class="row g-3 mb-5">
            @foreach (var match in _page.ActiveMatches)
            {
                <div class="col-lg-6">
                    <FilmPerformanceCard Card="match" Variant="FilmPerformanceCardVariant.Featured" />
                </div>
            }
        </div>
    }
    else if (_page.HasAnyTrackedMovie)
    {
        <div class="alert alert-light border mb-5">No matches yet — you'll see them here the moment a tracked film's screening fits your preferences.</div>
    }
    else
    {
        <div class="alert alert-light border mb-5">No matches yet — <a href="/tracked-movies">start by marking a film as tracked</a>.</div>
    }

    <div class="row g-3">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header bg-white cs-heading fw-semibold" style="font-size:1rem;">Tracked Movies</div>
                @foreach (var row in _page.TrackedMovies)
                {
                    @if (row.NextPerformance is { } nextPerformance)
                    {
                        <FilmPerformanceCard Card="nextPerformance" Variant="FilmPerformanceCardVariant.Compact" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2 py-2 px-3 border-bottom">
                            <i class="bi bi-bookmark-star-fill" style="color:var(--cinescout-accent-match);"></i>
                            <span class="fw-semibold cs-heading">@row.FilmTitle</span>
                            <span class="text-muted small">No upcoming performances</span>
                        </div>
                    }
                }
                <div class="card-body py-2"><a href="/tracked-movies" class="small">View all →</a></div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header bg-white cs-heading fw-semibold" style="font-size:1rem;">Recent Activity</div>
                <ul class="list-group list-group-flush">
                    @foreach (var activity in _page.RecentActivity)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@activity.FilmTitle</span>
                            <span class="text-muted small">@RelativeTimeFormatter.Format(activity.SentAt, DateTimeOffset.UtcNow)</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
}

@code {
    private HomePageDto? _page;

    protected override async Task OnInitializedAsync()
    {
        if (RendererInfo.IsInteractive)
        {
            _page = await Api.GetAsync();
        }
    }
}
